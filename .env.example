# Configuracion de las corridas del generador.
#
# Copiar este archivo a `.env` y ajustar los valores. `.env` esta en .gitignore,
# asi que los valores locales nunca se commitean.
#
#   cp .env.example .env
#
# Estas variables las lee el script de entrada, NO la libreria. `gsssp` recibe todo
# por parametro; el script traduce estas variables a esos parametros.

# Carpeta donde se escriben las imagenes y las etiquetas. Obligatoria: sin ella el
# script corta al arrancar en vez de generar en un lugar arbitrario.
# Se crean adentro las subcarpetas `images/` y `labels/`.
GASP_OUTPUT_DIR=/ruta/a/tu/dataset

# Cantidad de imagenes por lote. Default 32.
GASP_BATCH_SIZE=32

# Cantidad de lotes a generar. El total de imagenes es BATCH_SIZE * BATCH_COUNT.
# Default 3000, que con batch 32 da 96000 imagenes.
GASP_BATCH_COUNT=3000

# Numero desde el que arranca la numeracion de los archivos. Sirve para ampliar un
# dataset existente sin pisar lo que ya hay. Default 0.
GASP_BEGIN_NUM=0
